{
  "manifest_version": 2,
  "name": "NoGender",
  "version": "1.3",
  "description": "Entfernt Gendersprache von Webseiten. Läuft vollständig lokal.",
  "icons": {
    "48": "icons/iconng_48.png",
    "128": "icons/iconng_128.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["nogender.js"],
      "run_at": "document_end",
      "all_frames": true
    }
  ],
  "permissions": [],
  "browser_action": {
    "default_popup": "popup.html",
    "default_title": "NoGender Feedback"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "nogender@example.com",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "options_ui": {
    "page": "popup.html",
    "open_in_tab": true
  }
}
